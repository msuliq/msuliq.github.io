{
  "name": "msuliq-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site for Suleyman Musayev. Static site built with Jekyll + Tailwind CSS, served by GitHub Pages.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "build": "npm run build:css"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@tailwindcss/typography": "^0.5.15"
  }
}
